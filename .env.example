# Vercel Postgres — populate automatically when you link the project in the
# Vercel dashboard (Storage -> Postgres -> Connect to Project). Copy the
# values it generates into .env.local for local dev.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Restrict sign-in to this Google Workspace domain
AUTH_ALLOWED_DOMAIN=raynorrealtync.com
